%p
  - if race.registerable?
    = t('.registration_closes')
    = deadline_readable(race.local(race.registration_close))

  %br

  - if Time.zone.now < race.registration_open
    = t('.registration_opens')
    = human_date(race.local(race.registration_open))
    %br
    = t('.registration_closes')
    = deadline_date(race.local(race.registration_close))

  %br

  = race.spots_remaining
  = t '.spots_remaining'

  - if race.full?
    %h5
      = t('.race_is_full')
    = pluralize(race.waitlist_count, t('.team'))
    = t('.on_waitlist')
