- if current_user && current_user.is_any_of?(:admin, :operator)
  .btn-group
    %button.btn.btn-default.dropdown-toggle{:type => 'button', :'data-toggle' => 'dropdown'}
      %i.fa.fa-save.fa-fw
      = t('.export')
      %span.caret
    %ul.dropdown-menu{:role => 'menu'}
      %li
        = mail_to Person.registered_for_race(race.id).map(&:email).uniq.join(',') do
          %i.fa.fa-envelope.fa-fw
          All Registered Dawgs
      %li.divider
      %li.dropdown-header
        Team exports
        %i.fa.fa-info-circle.fa-fw{:title => 'Team names are saved using library rules: "The Secret Gentlemen" becomes "Secret Gentlemen, The", so teams that start with "The" are not all filed under T.', :'aria-label' => 'Team names are saved using library rules: "The Secret Gentlemen" becomes "Secret Gentlemen, The"', :tabindex => 0, :role => 'img'}
      %li
        = link_to race_export_url(race, :finalized => true) do
          %i.fa.fa-table.fa-fw
          = t('.finalized_teams')
      %li
        = link_to race_export_url(race) do
          %i.fa.fa-table.fa-fw
          = t('.all_teams')
