= form_for [@team, @person], :html => {:role => 'form', :class => 'form-horizontal'} do |f|
  .form-group
    .col-xs-4.control-label
      = label_tag :first_name, t('.first_name')
    .col-xs-6
      = f.text_field :first_name, :class => 'form-control'
  .form-group
    .col-xs-4.control-label
      = label_tag :last_name, t('.last_name')
    .col-xs-6
      = f.text_field :last_name, :class => 'form-control'
  .form-group
    .col-xs-4.control-label
      = label_tag :email, t('.email')
    .col-xs-6
      = f.text_field :email, :class => 'form-control'
  .form-group
    .col-xs-4.control-label
      = label_tag :phone, t('.phone')
      %br
      = t('.we_will_sms')
    .col-xs-6
      = f.text_field :phone, :class => 'form-control'
  .form-group
    .col-xs-4.control-label
      = label_tag :experience, t('.experience')
    .col-xs-5
      = f.number_field :experience, :min => 0, :max => 99, :class => 'form-control'
  .form-group
    .col-xs-4.control-label
      = label_tag :instagram, t('.instagram')
    .col-xs-4
      = f.text_field :instagram, :class => 'form-control'
  .form-group
    .col-xs-4.control-label
      = label_tag :tiktok, t('.tiktok')
    .col-xs-4
      = f.text_field :tiktok, :class => 'form-control'
  .form-group
    .col-xs-offset-4.col-xs-8
      = f.submit t('save'), :class => ['btn', 'btn-default']
      = link_to team_path(@team.id) do
        .btn.btn-default
          = t('back')
