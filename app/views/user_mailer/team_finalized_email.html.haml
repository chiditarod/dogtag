%html
  %head
    %meta{"http-equiv" => "Content-Type", :content => "text/html; charset=utf-8"}
  %body
    %h1 dogtag  :::  Chiditarod registration bot
    %h4
      Congratulations on completing your
      = @team.race.name
      registration. You are now
      %b
        Fully Registered.
    %p
      Team:
      = @team.name
      - if @team.assigned_team_number.present?
        (Team ##{@team.assigned_team_number})
    %p
      Racers:
      %ul
        - @team.people.each do |p|
          %li
            = p.first_name
            = p.last_name
    %p
      You can update your team information at
      - team_link = RegistrationUi.team_url(@team)
      %a{:href=>team_link}
        = team_link
      until
      = deadline_readable(@team.race.local(@team.race.registration_close))
      when registration closes.

    - confirmation_html = ConfirmationText.to_html(@team.race.confirmation_text)
    - if confirmation_html
      %div= confirmation_html

    - if @team.race.classy_campaign_id.present?
      - if @team.classy_fundraising_url
        %p
          Your fundraising page:
          %a{:href => @team.classy_fundraising_url}
            = @team.classy_fundraising_url
      - else
        %p
          Your fundraising page is being set up; watch for a separate email.

    %p
      Problems? Email
      %a{:href => "mailto:dogtag@chiditarod.org"}
        dogtag@chiditarod.org

    %p
      glory,
      %br
      %a{:href=>"mailto:dogtag@chiditarod.org"}
        dogtag bot
