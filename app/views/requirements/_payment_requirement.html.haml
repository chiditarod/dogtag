- if req.completed?(team)
  -# todo: this is now my least favorite part of this codebase. put this somewhere better.
  - cr = req.cr_for(team)
  - if cr.refunded?
    %span.label.label-primary
      = t('refunded')
    - if can? :reopen, :charges
      = button_to t("reopen_payment"), reopen_completed_requirement_path(cr), :method=>:post, :data => { :confirm => "Reopen this payment so the team can pay again?" }, :class=> %w(btn btn-default)
  - else
    %i.fa.fa-check-circle-o.fa-5x.pull-left
    .lead
      $
      = price_in_dollars_and_cents cr.metadata['amount']
    = t('completed')

    - if can? :refund, :charges
      = button_to t("refund"), charge_refund_url(cr.charge_id), :method=>:post, :data => { :confirm => "Are you sure?" }, :class=> %w(btn btn-danger)
    - if can? :reopen, :charges
      = button_to t("refund_and_reopen"), charge_refund_url(cr.charge_id), :method=>:post, :data => { :confirm => "Refund this payment and reopen it so the team can pay again?" }, :class=> %w(btn btn-danger), :params => {:reopen => true}

- else

  - if req.race.open_for_registration?
    .lead
      $
      = price_in_dollars_and_cents(req.active_tier.price)

      -# show next tiers
      - unless req.next_tiers.empty?
        %small
          %small
            %small
              - req.next_tiers.each do |tier|
                %br
                %em
                  $
                  = price_in_dollars_and_cents(tier.price)
                  \:
                  = human_date_short(req.race.local(tier.begin_at))

    - if @race.full?
      %h4.text-warning
        = t('.no_pay_waitlist')
    - elsif @team.needs_people? && !current_user.is_any_of?(:admin, :operator)
      %h4.text-warning
        = t('.no_pay_roster')
    - else
      = render 'charges/embed', :params => req.stripe_params(@team)

  - else
    %i.lead.text-danger
      %i.fa.fa-lock.fa-5x
      /= payment system locked when registration is closed
      %br
      = t('.no_complete_when_closed')
